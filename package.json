{
  "name": "effect-ts-by-example",
  "version": "1.0.0",
  "description": "Learning Effect-TS by example",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "example:dev": "tsx src/example.ts",
    "example": "node dist/example.js",
    "coar-notification-example:dev": "tsx src/coar-notification-example.ts",
    "coar-notification-example": "node dist/coar-notification-example.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "effect",
    "effect-ts",
    "typescript",
    "functional-programming"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@effect/platform": "^0.92.1",
    "effect": "^3.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-fp-ts": "^0.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-loops": "^0.3.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
